# DeepSeek API (серверные переменные — не попадают в клиентский бандл)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Firebase (NEXT_PUBLIC_* — публичные переменные, безопасны для клиента)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Защита /api/ai (платный DeepSeek) ───────────────────────────────────────
# Режим проверки Firebase ID-token:
#   required — без токена 401 (значение по умолчанию, для продакшена);
#   optional — анонимов пускаем, но считаем их по IP с более жёстким лимитом;
#   off      — только для локальной разработки, НИКОГДА в продакшене.
AI_AUTH_MODE=required

# Проект Firebase, чьи токены принимаем. Если не задан — берётся
# NEXT_PUBLIC_FIREBASE_PROJECT_ID. Без обоих /api/ai отвечает 500
# server_misconfigured (честная ошибка вместо «тихо пускаем всех»).
FIREBASE_PROJECT_ID=your-project

# Лимиты на /api/ai. Скользящее окно в памяти процесса: на serverless-инстанс.
# Клиент получает 429 + Retry-After и X-RateLimit-*.
AI_RATE_USER_LIMIT=40
AI_RATE_USER_WINDOW_MS=300000
AI_RATE_IP_LIMIT=20
AI_RATE_IP_WINDOW_MS=300000
AI_RATE_GLOBAL_LIMIT=600
AI_RATE_GLOBAL_WINDOW_MS=60000

# Федерация EduOS (серверные переменные — секрет НИКОГДА не должен иметь префикс NEXT_PUBLIC_)
# EDUOS_SSO_SECRET должен совпадать с LEADAI_SSO_SECRET в EduOS.
# Без него /api/federation/sso отвечает 404, а /federation не подтверждает личность.
EDUOS_SSO_SECRET=leadai-bridge-secret
EDUOS_FEDERATION_URL=https://eduos.example.org
